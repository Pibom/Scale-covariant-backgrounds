        RowBox[{"\"\<InvalidNumericalValue\>\"", ",", " ", 
         RowBox[{"<|", 
          RowBox[{"\"\<Input\>\"", " ", "->", " ", "s"}], "|>"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"readNumber", "[", "x_", "]"}], " ", ":=", " ", 
