    RowBox[{"NumberQ", "[", "x", "]"}], " ", "&&", " ", 
    RowBox[{"FreeQ", "[", 
     RowBox[{"x", ",", " ", 
      RowBox[{
      "Indeterminate", " ", "|", " ", "ComplexInfinity", " ", "|", " ", 
       RowBox[{"_", "DirectedInfinity"}]}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"readNumber", "[", "s_String", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
