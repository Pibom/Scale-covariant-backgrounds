         RowBox[{"<|", 
          RowBox[{"\"\<Input\>\"", " ", "->", " ", "v"}], "|>"}]}], "]"}]}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
