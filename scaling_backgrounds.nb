     RowBox[{"{", 
      RowBox[{"value", " ", "=", " ", 
       RowBox[{"parseNumber", "[", "s", "]"}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"finiteNumberQ", "[", "value", "]"}], " ", "&&", " ", 
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"Im", "[", "value", "]"}], " ", "==", " ", "0"}], "]"}]}], ",",
