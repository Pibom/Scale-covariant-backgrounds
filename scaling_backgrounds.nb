          RowBox[{"record", "[", "\"\<masses\>\"", "]"}]}], "]"}]}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"solutions", " ", "=", " ", 
