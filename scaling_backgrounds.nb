          RowBox[{"Length", "[", "result", "]"}], " ", "===", " ", "23"}]}], ",",
         " ", "result", ",", 
        RowBox[{"Failure", "[", 
         RowBox[{"\"\<BackgroundResidualEvaluationFailed\>\"", ",", " ", 
          RowBox[{"<|", 
           RowBox[{"\"\<Background\>\"", " ", "->", " ", "x"}], "|>"}]}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BackgroundResidual", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"equationResidualsAt", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FailureQ", "[", "result", "]"}], ",", " ", "result", ",", " ", 
       RowBox[{"Drop", "[", 
        RowBox[{"result", ",", " ", "2"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CheckBackground", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"result", " ", "=", " ", 
        RowBox[{"equationResidualsAt", "[", "x", "]"}]}], ",", " ", 
       "maximum"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"FailureQ", "[", "result", "]"}], ",", " ", 
        RowBox[{"Return", "[", "result", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"maximum", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "[", "result", "]"}], "]"}]}], ";", 
      RowBox[{"{", 
       RowBox[{"maximum", ",", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"maximum", " ", "<", " ", 
           RowBox[{"10", "^", 
            RowBox[{"-", "10"}]}]}], ",", " ", "\"\<Below treshold\>\"", ",", 
          " ", "\"\<Above or equal to treshold\>\""}], "]"}]}], "}"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CheckAllBackgrounds", "[", "]"}], " ", ":=", 
   RowBox[{"Grid", "[", 
    RowBox[{
     RowBox[{"Prepend", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"result", " ", "=", " ", 
             RowBox[{"CheckBackground", "[", "j", "]"}]}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"FailureQ", "[", "result", "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"j", ",", " ", 
               RowBox[{"label", "[", "j", "]"}], ",", " ", "result", ",", 
               " ", "\"\<Evaluation failed\>\""}], "}"}], ",", " ", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"j", ",", " ", 
                 RowBox[{"label", "[", "j", "]"}]}], "}"}], ",", " ", 
               "result"}], "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", " ", "solutionCount"}], "}"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Index\>\"", ",", " ", "\"\<Label\>\"", ",", 
         " ", "\"\<Maximum residual\>\"", ",", " ", "\"\<Check\>\""}], 
        "}"}]}], "]"}], ",", " ", 
     RowBox[{"Frame", " ", "->", " ", "All"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Backgrounds\>\"", " ", "->", " ", "solutionCount"}], ",", " ", 
   RowBox[{"\"\<Fields\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", "fields", "]"}]}]}], "|>"}]}], "Input",
