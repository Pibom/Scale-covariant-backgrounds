          RowBox[{"\"\<Label\>\"", " ", "->", " ", "x"}], "|>"}]}], "]"}], ",",
        " ", 
       RowBox[{"solutions", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"solutionRecord", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Failure", "[", 
    RowBox[{"\"\<BackgroundRequiresIndexOrLabel\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{"\"\<Input\>\"", " ", "->", " ", "x"}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"withSolution", "[", 
    RowBox[{"x_", ",", " ", "function_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"record", " ", "=", " ", 
       RowBox[{"solutionRecord", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FailureQ", "[", "record", "]"}], ",", " ", "record", ",", " ", 
       RowBox[{"function", "[", "record", "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"index", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"withSolution", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{
      RowBox[{"#", "[", "\"\<index\>\"", "]"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"label", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"withSolution", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{
      RowBox[{"#", "[", "\"\<label\>\"", "]"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"indexForLabel", "[", "x_String", "]"}], " ", ":=", " ", 
   RowBox[{"index", "[", "x", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"indexForLabel", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Failure", "[", 
    RowBox[{"\"\<BackgroundLabelMustBeString\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{"\"\<Input\>\"", " ", "->", " ", "x"}], "|>"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AdSLength", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"withSolution", "[", 
    RowBox[{"x", ",", " ", 
     RowBox[{
      RowBox[{"#", "[", "\"\<L_AdS\>\"", "]"}], " ", "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaValue", "[", "x_", "]"}], " ", ":=", " ", 
